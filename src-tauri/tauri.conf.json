{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yt-dlp Client",
  "version": "1.3.0",
  "identifier": "lk.chamindu.ytdlpc",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "yt-dlp Client",
        "width": 1200,
        "height": 800,
        "minWidth": 850,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "publisher": "Chamindu Dilshan",
    "homepage": "https://ytdlpc.chamindu.lk",
    "copyright": "Copyright (c) 2026 Chamindu Dilshan. All rights reserved.",
    "shortDescription": "Native, lightweight Windows desktop client for yt-dlp, FFmpeg, and ffprobe.",
    "longDescription": "A modern, high-performance Windows client for yt-dlp, FFmpeg, and ffprobe featuring multi-platform search, batch downloads, playlist extraction, SponsorBlock filtering, 1:1 album art cropping, metadata tagging, subtitles, and portable mode.",
    "category": "Video",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/Square30x30Logo.png",
      "icons/Square44x44Logo.png",
      "icons/Square71x71Logo.png",
      "icons/Square89x89Logo.png",
      "icons/Square107x107Logo.png",
      "icons/Square142x142Logo.png",
      "icons/Square150x150Logo.png",
      "icons/Square284x284Logo.png",
      "icons/Square310x310Logo.png",
      "icons/StoreLogo.png"
    ],
    "resources": [
      "bin/*"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "wix": {
        "version": "1.3.0"
      }
    }
  }
}
