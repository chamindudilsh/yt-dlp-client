{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "yt-dlp Client",
  "version": "1.0.0",
  "identifier": "com.ytdlp.client",
  "build": {
    "beforeDevCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "yt-dlp Client",
        "width": 1200,
        "height": 800,
        "minWidth": 850,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Chamindu Dilshan",
    "copyright": "Copyright (c) 2026 Chamindu Dilshan. All rights reserved.",
    "shortDescription": "Native, ultra-lightweight Windows GUI for yt-dlp",
    "longDescription": "Minimalist Windows client GUI for yt-dlp with batch downloads, playlist extraction, SponsorBlock, 1:1 album art cropping, metadata tagging, subtitles, and portable mode.",
    "category": "Video",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/Square30x30Logo.png",
      "icons/Square44x44Logo.png",
      "icons/Square71x71Logo.png",
      "icons/Square89x89Logo.png",
      "icons/Square107x107Logo.png",
      "icons/Square142x142Logo.png",
      "icons/Square150x150Logo.png",
      "icons/Square284x284Logo.png",
      "icons/Square310x310Logo.png",
      "icons/StoreLogo.png"
    ],
    "resources": [
      "bin/*"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "yt-dlp Client",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "version": "1.0.0",
        "upgradeCode": "e1f7a2d4-3c6b-4b2a-89f5-1b3c7e9d4a20",
        "language": "en-US"
      }
    }
  }
}
