{
  "name": "yt-dlp-client",
  "description": "Native, lightweight Windows desktop client for yt-dlp, FFmpeg, and ffprobe",
  "author": "Chamindu Dilshan",
  "license": "MIT",
  "homepage": "https://github.com/chamindudilsh/yt-dlp-client",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=server-dist/server.cjs",
    "build:tauri": "vite build --mode tauri",
    "build:web": "vite build --mode web && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=server-dist/server.cjs",
    "start": "node server-dist/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check": "npm run lint && npm run check:rust",
    "bump": "node scripts/bump-version.js",
    "tauri": "tauri",
    "tauri:icons": "tauri icon icon.png",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run tauri:icons && tauri build --no-bundle"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/plugin-notification": "^2.5.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
